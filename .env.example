# SPS Pipeline Bot — environment variables
# Copy this file to .env and fill in your values.
# Then: export $(cat .env | xargs)

# Your Slack browser session token (xoxc-...) — see SLACK-SETUP.md Step 1
SLACK_USER_TOKEN=xoxc-your-token-here

# Your Slack session cookie value (just the d= value) — see SLACK-SETUP.md Step 1
SLACK_COOKIE=your-d-cookie-value-here

# GitHub Personal Access Token for github.ibm.com — see SLACK-SETUP.md Step 2
# Required scopes: repo (full)
GITHUB_TOKEN=ghp_your-pat-here

# Incoming webhook URL from your existing notification Slack app — see SLACK-SETUP.md Step 3
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your-webhook-here
