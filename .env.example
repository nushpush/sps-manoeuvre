# SPS Pipeline Bot — environment variables
# Copy this file to .env and fill in your values.
# Then: export $(cat .env | xargs)
#
# NOTE: On macOS, SLACK_USER_TOKEN and SLACK_COOKIE are extracted automatically
# from the Slack desktop app after running --bootstrap. You do NOT need to set them here.
# On Linux/Windows, set them manually (see README.md#manual-token-setup-non-macos).

# GitHub Personal Access Token for github.ibm.com (and github.com for IBM/* repos)
# Required scopes: repo (full)
# Get it: https://github.ibm.com/settings/tokens → Generate new token (classic) → tick repo
GITHUB_TOKEN=ghp_your-token-here

# Incoming webhook URL from your Slack notification app
# Get it: https://api.slack.com/apps → your app → Incoming Webhooks → Add webhook
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your-webhook-here

# IBM Cloud API key — used to fetch Tekton pipeline run logs in --monitor mode
# Get it: https://cloud.ibm.com/iam/apikeys → Create
# Leave empty if you are not using the failure monitor
IBM_CLOUD_API_KEY=your-ibm-cloud-api-key-here

# ---------------------------------------------------------------------------
# Slack session tokens — macOS only: leave blank (auto-extracted via --bootstrap)
# Linux/Windows: extract from browser DevTools (see README.md for instructions)
# ---------------------------------------------------------------------------

# Your personal Slack session token (xoxc-...)
SLACK_USER_TOKEN=xoxc-your-token-here

# Your Slack session cookie value (xoxd-...)
SLACK_COOKIE=xoxd-your-cookie-here
