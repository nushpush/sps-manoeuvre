<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sps-pipeline-bot.daily-run</string>

    <!-- IMPORTANT: Update the path below to your actual project location before installing.
         Install with: cp scripts/com.sps-pipeline-bot.daily-run.plist ~/Library/LaunchAgents/
                       launchctl load ~/Library/LaunchAgents/com.sps-pipeline-bot.daily-run.plist -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/path/to/sps-pipeline-bot/scripts/daily-run.sh</string>
    </array>

    <!-- Run every day at 09:00 local time -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/path/to/sps-pipeline-bot/.bob/daily-run.log</string>
    <key>StandardErrorPath</key>
    <string>/path/to/sps-pipeline-bot/.bob/daily-run.log</string>

    <!-- Run even if the machine was asleep at the scheduled time -->
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
